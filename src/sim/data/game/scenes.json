        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "The fog swallowed everything past the Townhall. But fog, like most things in this kingdom, can be bought back.",
        "box": "bottom",
        "point": "",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "See the trees in the dark? Tap that patch. Five taps clear a cell, and every tap costs a pinch of Gold.",
        "box": "auto",
        "point": "feature:Trees",
        "lock": "target",
        "until": "questProgress",
        "untilTarget": "FirstSteps",
        "untilAmount": 1,
        "exit": false
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Timber! Clear three more forest cells — the scroll keeps count.",
        "box": "auto",
        "point": "feature:Trees",
        "lock": "map",
        "until": "questComplete",
        "untilTarget": "FirstSteps",
        "untilAmount": 0,
        "exit": false
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "A task done is a reward waiting. Tap the scroll.",
        "box": "middle",
        "point": "quest",
        "lock": "target",
        "until": "questClaimed",
        "untilTarget": "FirstSteps",
        "untilAmount": 0,
        "exit": false
      }
    ]
