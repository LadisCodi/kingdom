        "point": "feature:BerryBush",
        "lock": "none",
        "until": "questComplete",
        "untilTarget": "Rations",
        "untilAmount": 0,
        "exit": false,
        "expression": "worried"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Berries enough for a whole household! The townsfolk have something for you — do accept it.",
        "box": "middle",
        "point": "quest",
        "lock": "target",
        "until": "questClaimed",
        "untilTarget": "Rations",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      }
    ]
  },
  {
