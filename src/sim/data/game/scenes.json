      {
        "speaker": "advisor",
        "side": "left",
        "text": "Close the book and let’s put it to use.",
        "box": "middle",
        "point": "ui:close",
        "lock": "target",
        "until": "noOverlay",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false
