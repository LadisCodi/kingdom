  {
    "id": "intro",
    "trigger": "questReached",
    "triggerTarget": "FirstSteps",
    "triggerAmount": 0,
    "anywhere": false,
    "skippable": false,
    "lines": [
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Your Majesty! Welcome home to Oakville — or to what the fog has left of it.",
        "box": "bottom",
        "point": "",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "I am Isolde, your Royal Advisor. I keep the maps, the ledgers and, on good days, the peace.",
        "box": "bottom",
        "point": "",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "The fog swallowed everything past the Townhall — our forests, our fields, our people's work. We must win it back.",
        "box": "bottom",
        "point": "",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": "worried"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Those trees in the dark are ours to reclaim. Tap that patch: five taps clear a cell, and each costs a pinch of Gold.",
        "box": "auto",
        "point": "feature:TreesFog",
        "lock": "target",
        "until": "questProgress",
        "untilTarget": "FirstSteps",
        "untilAmount": 1,
        "exit": false,
        "expression": "idea"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Timber! The forest remembers us. Three more stands, and our axes will have work again.",
        "box": "auto",
        "point": "feature:TreesFog",
        "lock": "map",
        "until": "questComplete",
        "untilTarget": "FirstSteps",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Splendid work, Your Majesty! The scroll has a reward for you — tap it.",
        "box": "middle",
        "point": "quest",
        "lock": "target",
        "until": "questClaimed",
        "untilTarget": "FirstSteps",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      }
    ]
  },
