[
  {
    "id": "intro",
    "trigger": "questReached",
    "triggerTarget": "FirstSteps",
    "triggerAmount": 0,
    "anywhere": false,
    "skippable": false,
    "lines": [
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Oh! Your Majesty — you came! Welcome home to Oakville. Well… to what the fog has left of it.",
        "box": "bottom",
        "point": "",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "I’m Isolde. I kept the royal library — but everyone else fled the fog, so… I’m your Royal Advisor now. I’ll do my very best!",
        "box": "bottom",
        "point": "",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "The fog swallowed everything past the Townhall — our forests, our fields, our people’s work. The books say it can be pushed back. I hope.",
        "box": "bottom",
        "point": "",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": "worried"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Those trees in the fog are ours! A few coins and a little patience clear a patch — tap it, Your Majesty. Five times, I’ve read.",
        "box": "auto",
        "point": "feature:TreesFog",
        "lock": "target",
        "until": "questProgress",
        "untilTarget": "FirstSteps",
        "untilAmount": 1,
        "exit": false,
        "expression": "idea"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Timber! Oh, it worked! Three more stands, and our axes will have work again.",
        "box": "auto",
        "point": "feature:TreesFog",
        "lock": "map",
        "until": "questComplete",
        "untilTarget": "FirstSteps",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "The townsfolk saw you win the woods back — they’ve gathered a gift! Go on, accept it. They’d be ever so pleased.",
        "box": "middle",
        "point": "quest",
        "lock": "target",
        "until": "questClaimed",
        "untilTarget": "FirstSteps",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      }
    ]
  },
  {
    "id": "morningBook",
    "trigger": "questReached",
    "triggerTarget": "Woodcraft",
    "triggerAmount": 0,
    "anywhere": true,
    "skippable": false,
    "lines": [
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Trees at last — and, um, nobody left who remembers how to fell them. But I have a book for that! I have a book for most things.",
        "box": "middle",
        "point": "ui:nav:research",
        "lock": "target",
        "until": "overlay",
        "untilTarget": "research",
        "untilAmount": 0,
        "exit": false,
        "expression": "worried"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Each page is a craft our people can learn. This one’s Forestry — chapter one. My favourite!",
        "box": "bottom",
        "point": "ui:tech:Forestry",
        "lock": "target",
        "until": "ui",
        "untilTarget": "techsheet:Forestry",
        "untilAmount": 0,
        "exit": false,
        "expression": "idea"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Learning takes Knowledge, and ours is right here. Pour it in…",
        "box": "auto",
        "point": "ui:tech-pour",
        "lock": "target",
        "until": "techFilled",
        "untilTarget": "Forestry",
        "untilAmount": 0,
        "exit": false,
        "expression": ""
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "…then a little Gold for the tools, and the craft is ours. Just like that!",
        "box": "auto",
        "point": "ui:tech-research",
        "lock": "target",
        "until": "techDone",
        "untilTarget": "Forestry",
        "untilAmount": 0,
        "exit": false,
        "expression": ""
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Listen — axes in the woods already! And I keep studying: a point of Knowledge an hour, up to ten. Best spend it before then.",
        "box": "middle",
        "point": "ui:knowledge",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Let’s close the book and go and watch them work. I’ll — I’ll mark the page.",
        "box": "middle",
        "point": "ui:close",
        "lock": "target",
        "until": "noOverlay",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": ""
      }
    ]
  },
  {
    "id": "morningAxe",
    "trigger": "questReached",
    "triggerTarget": "Timber",
    "triggerAmount": 0,
    "anywhere": false,
    "skippable": false,
    "lines": [
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Shall we show them how it’s done? Tap a tree. Each swing draws a drop of Mana — the kingdom’s magic, in that blue well up there.",
        "box": "auto",
        "point": "feature:TreesRevealed",
        "lock": "map",
        "until": "taps",
        "untilTarget": "",
        "untilAmount": 3,
        "exit": false,
        "expression": ""
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Hold your finger down and the axe keeps swinging! When a stand is bare, move on — it grows back. Trees are patient like that.",
        "box": "auto",
        "point": "feature:TreesRevealed",
        "lock": "none",
        "until": "questComplete",
        "untilTarget": "Timber",
        "untilAmount": 0,
        "exit": false,
        "expression": "idea"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Oh — the well is lower. Every swing drew a drop. Don’t fret! It fills itself again, slowly, hour by hour. I checked twice.",
        "box": "auto",
        "point": "ui:mana",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": "worried"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Wood for the kingdom! The woodfolk have sent their thanks — accept it, and the well gets a little of its magic back.",
        "box": "middle",
        "point": "quest",
        "lock": "target",
        "until": "questClaimed",
        "untilTarget": "Timber",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      }
    ]
  },
  {
    "id": "morningRoof",
    "trigger": "questReached",
    "triggerTarget": "ARoof",
    "triggerAmount": 0,
    "anywhere": true,
    "skippable": false,
    "lines": [
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Wood at last — and not one roof to sleep under. Nobody will settle here like this. A House! We need a House.",
        "box": "middle",
        "point": "ui:nav:build",
        "lock": "target",
        "until": "overlay",
        "untilTarget": "build",
        "untilAmount": 0,
        "exit": false,
        "expression": "worried"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Builders want their wood up front — it says so in the guild charter. Choose the House.",
        "box": "auto",
        "point": "ui:build:Housing",
        "lock": "target",
        "until": "placing",
        "untilTarget": "Housing",
        "untilAmount": 0,
        "exit": false,
        "expression": ""
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Anywhere on the cleared ground. Drag it wherever feels right, then confirm. I’d pick somewhere sunny.",
        "box": "auto",
        "point": "ui:place-confirm",
        "lock": "map",
        "until": "placed",
        "untilTarget": "Housing",
        "untilAmount": 0,
        "exit": false,
        "expression": ""
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Hear that? Hammers! And builders keep at it while you’re away — they don’t need watching. Unlike me.",
        "box": "auto",
        "point": "district:Housing",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Our first roof! The townsfolk want to thank you for it — please, accept their gift.",
        "box": "middle",
        "point": "quest",
        "lock": "target",
        "until": "questClaimed",
        "untilTarget": "ARoof",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      }
    ]
  },
  {
    "id": "morningFood",
    "trigger": "questReached",
    "triggerTarget": "Rations",
    "triggerAmount": 0,
    "anywhere": false,
    "skippable": false,
    "lines": [
      {
        "speaker": "advisor",
        "side": "left",
        "text": "A roof is a start — but people eat, and our pantry is… a shelf. Berry bushes would do. Clear the fog off one, then pick it.",
