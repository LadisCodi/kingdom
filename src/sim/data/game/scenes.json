        "untilAmount": 1,
        "exit": false,
        "expression": ""
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "A roof, a pantry… now we need people! The Townhall calls settlers in from the roads. Open it, Your Majesty.",
        "box": "auto",
        "point": "district:Townhall",
        "lock": "target",
        "until": "ui",
        "untilTarget": "card:train",
        "untilAmount": 0,
        "exit": false,
        "expression": "idea"
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Call one! They’ll need that roof — and a little Food for the road.",
        "box": "auto",
        "point": "ui:card:train",
        "lock": "none",
        "until": "training",
        "untilTarget": "",
        "untilAmount": 1,
        "exit": false,
        "expression": ""
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "They’re on their way! We can wait for them to arrive — or a few Gems would hurry them along. Whichever you think best!",
        "box": "auto",
        "point": "ui:card:finish-training",
        "lock": "none",
        "until": "population",
        "untilTarget": "",
        "untilAmount": 1,
        "exit": false,
        "expression": "idea"
      },
      {
        "speaker": "villager",
        "side": "right",
        "text": "A roof, a hearth and a monarch! I’ll pay my rent on time, Your Majesty.",
        "box": "auto",
        "point": "",
        "lock": "all",
        "until": "tap",
        "untilTarget": "",
        "untilAmount": 0,
        "exit": false,
        "expression": ""
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Let’s close the Townhall — the townsfolk are waiting to thank you.",
        "box": "middle",
        "point": "ui:card:close",
        "lock": "target",
        "until": "ui",
        "untilTarget": "quest",
        "untilAmount": 0,
        "exit": false,
        "expression": ""
      },
      {
        "speaker": "advisor",
        "side": "left",
        "text": "Oakville has its first citizen! Oh, this calls for a celebration — they’ve brought you a gift. Accept it!",
        "box": "middle",
        "point": "quest",
        "lock": "target",
        "until": "questClaimed",
        "untilTarget": "FirstVillager",
        "untilAmount": 0,
        "exit": false,
        "expression": "happy"
      }
    ]
  },
  {
    "id": "morningRent",
    "trigger": "questReached",
