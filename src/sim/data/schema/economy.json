{
  "type": "object",
  "fields": {
    "tap": {
      "type": "object",
      "fields": {
        "collectCooldownSeconds": { "type": "float" },
        "manaCost": { "type": "int", "min": 0, "doc": "What every player tap costs." },
        "workSeconds": { "type": "int", "min": 1, "doc": "A tap pays this many seconds of what it touches produces." }
      }
    },
    "storage": {
      "type": "object",
      "fields": {
        "collectSeconds": {
          "type": "int",
          "min": 1,
          "doc": "A store is ready to collect — its bubble shows and a tap collects rather than opening the building — once it holds this many seconds of what the building makes now, or is full."
        }
      }
    },
    "taxes": { "type": "object", "fields": { "goldPerPopulationPerMinute": { "type": "int" } } },
    "mana": {
      "type": "object",
      "fields": {
        "baseCap": { "type": "int" },
        "basePerHour": { "type": "int" },
        "sanctumCapPerLevel": { "type": "list", "of": { "type": "int" }, "length": { "exact": 10 } },
        "sanctumPerHourPerLevel": { "type": "list", "of": { "type": "int" }, "length": { "exact": 10 } },
        "landmarkCap": { "type": "int" },
        "meditationCap": { "type": "int" },
        "gemRefillCosts": { "type": "list", "of": { "type": "int" } }
      }
    },
    "city": {
      "type": "object",
      "fields": {
        "initialCurrencies": { "type": "map", "of": { "type": "int" }, "keysRef": "currency" },
        "initialPopulation": { "type": "int" },
        "populationCostFirst": { "type": "list", "of": { "type": "int" } },
        "populationCostGrowth": { "type": "float" },
        "lateUpgradeFromLevel": { "type": "int" }
      }
    },
    "kingdom": {
      "type": "object",
      "fields": {
        "startBuilders": { "type": "int" },
        "maxBuilders": { "type": "int" },
        "builderGemCostBase": { "type": "int" },
        "builderGemCostGrowth": { "type": "int" }
      }
    },
    "harmony": {
      "type": "object",
      "fields": {
        "surplusTiers": {
          "type": "list",
          "of": { "type": "object", "fields": { "at": { "type": "float" }, "bonus": { "type": "float" } } }
        }
      }
    },
    "worker": { "type": "object", "fields": { "moveSpeedTilesPerSecond": { "type": "int" } } },
    "training": {
      "type": "object",
      "fields": { "seconds": { "type": "int" }, "villagerSecondsGrowth": { "type": "float", "min": 1 } }
    },
    "rush": { "type": "object", "fields": { "secondsPerGem": { "type": "int" } } }
  }
}
